# Paper Trail · THE LEDGER — copiar a .env en la raiz del proyecto y completar.
# chmod 600 .env   (tiene claves)

# --- LLM: OpenCode primero, Claude como red -------------------------------
# Los topes son POR MODELO (RADAR.md §11bis): Luna y GLM-Flash 12/30/60 USD,
# Kimi K3 solo 3/7,50/15. Si el analisis va en K3, que nada mas use K3.
# IMPRESCINDIBLE. Sin esta no hay guion, y sin guion no hay video.
OPENCODE_API_KEY=

# OPCIONAL. Es la red de la cascada: si OpenCode se agota, el guion lo escribe Claude.
# OJO: la suscripcion de Claude Code NO sirve aca. Son productos distintos y la API se paga
# por token aparte. Si no tenes credito de API, dejala vacia: el sistema anda igual.
ANTHROPIC_API_KEY=

# --- base ------------------------------------------------------------------
# DSN = la direccion de la base de datos. Le dice al sistema DONDE guardar los articulos y
# los acontecimientos. Se lee asi:
#   postgresql+psycopg :// usuario : clave @ maquina : puerto / nombre_de_la_base
# La base `radar` la crea el instalador dentro del Postgres de Supabase que ya corre aca.
# La clave se saca con:
#   docker exec $(docker ps --format "{{.Names}}" | grep -m1 supabase-db-) env | grep POSTGRES_PASSWORD
# Si lo dejas vacio, usa un archivo SQLite local: anda igual, pero agrupar tarda ~4 veces mas.
RADAR_DSN=postgresql+psycopg://postgres:CLAVE@127.0.0.1:5432/radar

# --- render ----------------------------------------------------------------
# 3 workers y prioridad baja: el VPS tiene 6 vCPU y ademas corre Supabase, n8n y Evolution API.
RENDER_WORKERS=3

# --- avisos ----------------------------------------------------------------
# El vigilante de las 10:00 UTC manda aca si el video no esta subido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- opcionales ------------------------------------------------------------
# RHUBARB=/usr/local/bin/rhubarb    # mejora el lip-sync; sin el sale del sobre de amplitud
# FAL_KEY=                          # solo para la ficha `plano` (1-2 imagenes por episodio)
